                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/habits/{{habitId}}/entries",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "habits",
                "{{habitId}}",
                "entries"
              ]
            }
          }
        },
        {
          "name": "Completion history",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Has entries\", () => pm.expect(pm.response.json().entries.length).to.be.above(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/habits/{{habitId}}/entries?from={{yesterday}}&to={{today}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "habits",
                "{{habitId}}",
                "entries"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "{{yesterday}}"
                },
                {
                  "key": "to",
                  "value": "{{today}}"
                }
              ]
            }
          }
        },
        {
          "name": "Streak",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Streak is at least 2\", () => pm.expect(pm.response.json().current_streak).to.be.at.least(2));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/habits/{{habitId}}/streak?today={{today}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "habits",
                "{{habitId}}",
                "streak"
              ],
              "query": [
                {
                  "key": "today",
                  "value": "{{today}}"
                }
              ]
            }
          }
        },
        {
          "name": "Remove an entry",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/habits/{{habitId}}/entries/{{yesterday}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "habits",
                "{{habitId}}",
                "entries",
                "{{yesterday}}"
              ]
            }
          }
        }
      ]
    },
