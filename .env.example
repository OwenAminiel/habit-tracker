PORT=3000

# Your PostgreSQL connection string (Supabase: use the "Session pooler" string, with no [brackets] around the password)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/habit_tracker
# true for hosted databases that require SSL (Supabase, Railway public URL)
DATABASE_SSL=false

# A long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Optional settings
# CORS_ORIGIN=https://your-site.example     # comma-separated list; without it any origin may call the API
# TRUST_PROXY=1                             # set to 1 behind a hosting proxy so rate limits see real visitor addresses
# LOG_REQUESTS=false                        # turn off the one-line-per-request log

# Optional: a SEPARATE database used only by `npm test`. The tests never use DATABASE_URL.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/habit_tracker_test
# TEST_DATABASE_SSL=false
